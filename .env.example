# Public endpoint URLs (safe to expose in browser builds).
VITE_API_BASE_URL=https://aurora-voicetext-qk8s.vercel.app
VITE_BACKUP_API_BASE_URL=

# Server-side only. Never prefix secrets with VITE_ and never commit real values.
GROQ_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional independent Cloudflare Worker failover (server-to-server).
BACKUP_BACKEND_URL=
BACKUP_BACKEND_TOKEN=

# Worker secrets; BACKUP_PUBLIC_FALLBACK=true enables origin-restricted app requests.
BACKUP_API_TOKEN=
BACKUP_PUBLIC_FALLBACK=false
