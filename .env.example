# Public endpoint URLs (safe to expose in browser builds).
VITE_API_BASE_URL=https://aurora-voicetext-qk8s.vercel.app
VITE_BACKUP_API_BASE_URL=

# Server-side only. Never prefix secrets with VITE_ and never commit real values.
# AssemblyAI enables automatic language detection and speaker diarization on online transcription.
ASSEMBLYAI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional independent Cloudflare Worker failover (server-to-server).
BACKUP_BACKEND_URL=
BACKUP_BACKEND_TOKEN=

# Worker secrets; BACKUP_PUBLIC_FALLBACK=true enables origin-restricted app requests.
BACKUP_API_TOKEN=
BACKUP_PUBLIC_FALLBACK=false

# Google Identity Services: use the same OAuth Web Client ID in both variables.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Supabase persistence for durable transcription jobs (server-side only).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECORDINGS_BUCKET=voicetext-recordings

# Shared secret for authenticated server-to-server requests from the main AURORA app.
# Set the same strong random value as VOICETEXT_PLUGIN_TOKEN in the main AURORA backend.
AURORA_PLUGIN_TOKEN=
