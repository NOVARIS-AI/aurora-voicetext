# Server-side only. Never prefix secrets with VITE_ and never commit real values.
GROQ_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional independent Cloudflare Worker failover.
BACKUP_BACKEND_URL=
BACKUP_BACKEND_TOKEN=

# Same private token configured as a Cloudflare Worker secret.
BACKUP_API_TOKEN=
